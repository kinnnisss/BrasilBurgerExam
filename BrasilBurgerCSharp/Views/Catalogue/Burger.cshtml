@model BrasilBurgerCSharp.ViewModels.Catalogue.BurgerDetailsVm
@{
    ViewData["Title"] = "Détails du burger";
    // On veut un header blanc "mobile style" sur cette page (comme ta capture)
    ViewBag.MinimalHeader = true;

    decimal burgerTotal = Model.Prix * (Model.Quantite <= 0 ? 1 : Model.Quantite);
}
@section Styles {
  <link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />
}

<section class="bb-detail">

    <!-- Top bar blanc comme sur la capture -->
    <div class="bb-detail-topbar">
        <a class="bb-detail-back" asp-controller="Catalogue" asp-action="Index" aria-label="Retour">←</a>
        <div class="bb-detail-title">Détails du burger</div>
        <a class="bb-detail-cart" asp-controller="Commande" asp-action="Panier" aria-label="Panier">
            🛒 <span class="bb-badge bb-badge--dark">0</span>
        </a>
    </div>

    <!-- Image -->
    <div class="bb-detail-hero">
        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <img src="@Model.Image" alt="@Model.Nom" class="bb-detail-hero__img" />
        }
        else
        {
            <div class="bb-detail-hero__placeholder"></div>
        }
    </div>

    <!-- Carte contenu -->
    <div class="bb-detail-card">
        <h1 class="bb-detail-name">@Model.Nom</h1>

        <!-- Description : tu n'as pas ce champ dans ton VM actuellement.
             Donc on laisse vide/optionnel (pour être 100% aligné modèle). -->
        <p class="bb-detail-desc">
            <!-- Si tu ajoutes Description plus tard, on l'affichera ici. -->
        </p>

        <div class="bb-detail-price">@($"{Model.Prix:0} FCFA")</div>

        <h2 class="bb-detail-subtitle">Ajouter des compléments</h2>

        <!-- Form POST aligné à CommandeController.AddBurger -->
        <form asp-controller="Commande" asp-action="AddBurger" method="post" class="bb-detail-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" id="qtyInput" name="quantite" value="@(Model.Quantite <= 0 ? 1 : Model.Quantite)" />

            @{
                var frites = Model.Complements.Where(c => (c.TypeComplement ?? "").ToUpperInvariant() == "FRITE").ToList();
                var boissons = Model.Complements.Where(c => (c.TypeComplement ?? "").ToUpperInvariant() == "BOISSON").ToList();
            }

            @if (frites.Count > 0)
            {
                <div class="bb-detail-group">
                    <div class="bb-detail-group__title">Frites</div>

                    <div class="bb-detail-list">
                        @foreach (var c in frites)
                        {
                            <label class="bb-detail-addon">
                                <input class="bb-detail-addon__check"
                                       type="checkbox"
                                       name="selectedComplementIds"
                                       value="@c.Id"
                                       data-price="@c.Prix" />

                                <div class="bb-detail-addon__imgWrap">
                                    @if (!string.IsNullOrWhiteSpace(c.Image))
                                    {
                                        <img src="@c.Image" alt="@c.Nom" />
                                    }
                                    else
                                    {
                                        <div class="bb-detail-addon__imgPh"></div>
                                    }
                                </div>

                                <div class="bb-detail-addon__info">
                                    <div class="bb-detail-addon__name">@c.Nom</div>
                                    <div class="bb-detail-addon__price">+@($"{c.Prix:0} FCFA")</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            @if (boissons.Count > 0)
            {
                <div class="bb-detail-group">
                    <div class="bb-detail-group__title">Boissons</div>

                    <div class="bb-detail-list">
                        @foreach (var c in boissons)
                        {
                            <label class="bb-detail-addon">
                                <input class="bb-detail-addon__check"
                                       type="checkbox"
                                       name="selectedComplementIds"
                                       value="@c.Id"
                                       data-price="@c.Prix" />

                                <div class="bb-detail-addon__imgWrap">
                                    @if (!string.IsNullOrWhiteSpace(c.Image))
                                    {
                                        <img src="@c.Image" alt="@c.Nom" />
                                    }
                                    else
                                    {
                                        <div class="bb-detail-addon__imgPh"></div>
                                    }
                                </div>

                                <div class="bb-detail-addon__info">
                                    <div class="bb-detail-addon__name">@c.Nom</div>
                                    <div class="bb-detail-addon__price">+@($"{c.Prix:0} FCFA")</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="bb-detail-qty">
                <div class="bb-detail-qty__label">Quantité</div>

                <div class="bb-detail-qty__controls">
                    <button type="button" class="bb-qty-btn bb-qty-btn--ghost" id="btnMinus">−</button>
                    <div class="bb-qty-value" id="qtyValue">@(Model.Quantite <= 0 ? 1 : Model.Quantite)</div>
                    <button type="button" class="bb-qty-btn" id="btnPlus">+</button>
                </div>
            </div>

            <div class="bb-detail-footer">
                <div class="bb-detail-total">
                    <div class="bb-detail-total__label">Total</div>
                    <div class="bb-detail-total__value" id="totalValue">@($"{burgerTotal:0} FCFA")</div>
                </div>

                <button type="submit" class="bb-detail-submit">
                    Ajouter au panier
                </button>
            </div>
        </form>
    </div>
</section>

<script>
(function(){
  const qtyInput = document.getElementById("qtyInput");
  const qtyValue = document.getElementById("qtyValue");
  const totalValue = document.getElementById("totalValue");
  const btnMinus = document.getElementById("btnMinus");
  const btnPlus = document.getElementById("btnPlus");

  const basePrice = Number("@Model.Prix".replace(",", "."));
  const checks = Array.from(document.querySelectorAll(".bb-detail-addon__check"));

  function getQty(){
    const q = parseInt(qtyInput.value || "1", 10);
    return isNaN(q) || q < 1 ? 1 : q;
  }

  function getAddonSum(){
    return checks
      .filter(c => c.checked)
      .reduce((acc, c) => acc + (parseFloat(c.dataset.price || "0") || 0), 0);
  }

  function render(){
    const q = getQty();
    qtyValue.textContent = String(q);

    const addons = getAddonSum();
    const total = (basePrice + addons) * q;

    totalValue.textContent = Math.round(total) + " FCFA";
  }

  btnMinus.addEventListener("click", () => {
    const q = Math.max(1, getQty() - 1);
    qtyInput.value = String(q);
    render();
  });

  btnPlus.addEventListener("click", () => {
    const q = getQty() + 1;
    qtyInput.value = String(q);
    render();
  });

  checks.forEach(c => c.addEventListener("change", render));

  render();
})();
</script>
