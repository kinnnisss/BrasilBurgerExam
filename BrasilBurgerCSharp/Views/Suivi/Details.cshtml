@model BrasilBurgerCSharp.DTOs.CommandeDetailsDto

@{
    ViewData["Title"] = "Détails de la commande";
    ViewBag.MinimalHeader = true;

        var cmd = Model.Commande;

    string Etat = (cmd.Etat ?? "").Trim().ToUpperInvariant();

    string NormalizeEtat(string? e)
    {
        var v = (e ?? "").Trim().ToUpperInvariant();
        return v switch
        {
            "TERMINER" => "TERMINEE",
            _ => v
        };
    }

    var etatNorm = NormalizeEtat(cmd.Etat);
    bool isAnnulee = etatNorm == "ANNULEE";

    int step = etatNorm switch
    {
        "ENCOURS" => 1,
        "VALIDEE" => 2,
        "TERMINEE" => 3,
        "ANNULEE" => 0,
        _ => 1
    };

    string BadgeClass(string? e)
    {
        var v = NormalizeEtat(e);
        return v switch
        {
            "ENCOURS" => "badge badge--encours",
            "VALIDEE" => "badge badge--validee",
            "TERMINEE" => "badge badge--terminee",
            "ANNULEE" => "badge badge--annulee",
            _ => "badge"
        };
    }

    string EtatBadge(string? e)
    {
        var v = NormalizeEtat(e);
        return v switch
        {
            "ENCOURS" => "En cours",
            "VALIDEE" => "Validée",
            "TERMINEE" => "Terminée",
            "ANNULEE" => "Annulée",
            _ => string.IsNullOrWhiteSpace(v) ? "—" : v
        };
    }


  string ConsoIco(string? t)
  {
      var v = (t ?? "").Trim().ToUpperInvariant();
      return v switch
      {
          "SUR_PLACE" => "🪑",
          "A_EMPORTER" => "🛍️",
          "LIVRAISON" => "🏍️",
          _ => "🍔"
      };
  }


    string ConsoLabel(string? t)
    {
        var v = (t ?? "").Trim().ToUpperInvariant();
        return v switch
        {
            "LIVRAISON" => "Livraison",
            "A_EMPORTER" => "À emporter",
            "SUR_PLACE" => "Sur place",
            _ => string.IsNullOrWhiteSpace(v) ? "—" : v
        };
    }

    string FormatDate(DateTime d) => d.ToString("d MMMM yyyy 'à' HH:mm", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));

    var sousTotal = (Model.Lignes ?? new List<BrasilBurgerCSharp.DTOs.LigneCommandeDto>()).Sum(x => x.PrixTotal);
    var typeCons = (cmd.TypeConsommation ?? "").Trim().ToUpperInvariant();
    var fraisLivraison = typeCons == "LIVRAISON" ? (cmd.MontantTotal - sousTotal) : 0m;
    if (fraisLivraison < 0) fraisLivraison = 0m; 
    string? TimeOrDash(DateTime? d) => d is null ? null : d.Value.ToString("HH:mm");

}

@section Styles{
  <link rel="stylesheet" href="~/css/pagebar.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/suivi-details.css" asp-append-version="true" />
}

@await Html.PartialAsync("_PageBar")

<section class="cmd-details">

    <div class="cmd-head">
        <div class="cmd-head__left">
            <div class="cmd-head__label">Référence</div>
            <div class="cmd-head__ref">@cmd.Reference</div>
            <div class="cmd-head__date">@FormatDate(cmd.DateCommande)</div>
        </div>
        <div class="cmd-head__right">
            <span class="cmd-badge @BadgeClass(cmd.Etat)">@EtatBadge(cmd.Etat)</span>
        </div>
    </div>

    <div class="cmd-card">
        <div class="cmd-card__title">État de la commande</div>

        @if (isAnnulee)
        {
            <div class="cmd-alert cmd-alert--cancel">
                <div class="cmd-alert__ico">⛔</div>
                <div class="cmd-alert__body">
                    <div class="cmd-alert__title">Commande annulée</div>
                    <div class="cmd-alert__text">
                        Cette commande a été annulée @(cmd.DateAnnulation is null ? "" : $"à {cmd.DateAnnulation.Value:HH:mm}"). La progression n’est plus applicable.
                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="timeline">
                <div class="tl-step @(step>=1 ? "is-done" : "") @(step==1 ? "is-current" : "")">
                    <div class="tl-dot">@(step==1 ? "✓" : "1")</div>
                    <div class="tl-body">
                        <div class="tl-title">En cours</div>
                        @if (step == 1)
                        {
                            <div class="tl-time">@cmd.DateCommande.ToString("HH:mm")</div>
                        }
                    </div>
                </div>

                <div class="tl-step @(step>=2 ? "is-done" : "") @(step==2 ? "is-current" : "")">
                    <div class="tl-dot">@(step>=2 ? "✓" : "2")</div>
                    <div class="tl-body">
                        <div class="tl-title">Validée</div>
                        @if (step == 2)
                        {
                            <div class="tl-time">@(TimeOrDash(cmd.DateValidation) ?? "—")</div>
                        }
                    </div>
                </div>

                <div class="tl-step @(step>=3 ? "is-done" : "") @(step==3 ? "is-current" : "")">
                    <div class="tl-dot">@(step>=3 ? "✓" : "3")</div>
                    <div class="tl-body">
                        <div class="tl-title">Terminée</div>
                        @if (step == 3)
                        {
                            <div class="tl-time">@(TimeOrDash(cmd.DateTerminaison) ?? "—")</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="cmd-card">
        <div class="cmd-card__title">Articles commandés</div>

        <div class="items">
            
            @foreach (var l in (Model.Lignes ?? Enumerable.Empty<BrasilBurgerCSharp.DTOs.LigneCommandeDto>()))
            {
                <div class="item">
                    <div class="item__img">
                        @if (!string.IsNullOrWhiteSpace(l.ImageArticle))
                        {
                            <img src="@l.ImageArticle" alt="@l.LibelleArticle" loading="lazy" />
                        }
                        else
                        {
                            <div class="img-ph"></div>
                        }
                    </div>

                    <div class="item__info">
                        <div class="item__name">@l.LibelleArticle</div>
                        <div class="item__qty">Quantité : @l.Quantite</div>
                    </div>

                    <div class="item__price">@($"{l.PrixTotal:0} FCFA")</div>
                </div>
            }
        </div>
    </div>

    <div class="cmd-card">
        <div class="meta">
            <div class="meta-row">
                <div class="meta-ico">@ConsoIco(cmd.TypeConsommation)</div>
                <div class="meta-text">
                    <div class="meta-label">Type de consommation</div>
                    <div class="meta-value">@ConsoLabel(cmd.TypeConsommation)</div>
                </div>
            </div>

            @if (typeCons == "LIVRAISON")
            {
                <div class="meta-row">
                    <div class="meta-ico">📍</div>
                    <div class="meta-text">
                        <div class="meta-label">Adresse de livraison</div>
                        <div class="meta-value">
                            @(!string.IsNullOrWhiteSpace(Model.Quartier) ? Model.Quartier : "—")<br />
                            @(!string.IsNullOrWhiteSpace(Model.Zone) ? Model.Zone : "—")
                        </div>
                    </div>
                </div>
            }

            <div class="meta-row">
                <div class="meta-ico">💳</div>
                <div class="meta-text">
                    <div class="meta-label">Mode de paiement</div>
                    <div class="meta-value">@(!string.IsNullOrWhiteSpace(Model.ModePaiement) ? Model.ModePaiement : "—")</div>
                </div>
            </div>
        </div>

        <div class="totals">
            <div class="t-row"><span>Sous-total</span><span>@($"{sousTotal:0} FCFA")</span></div>

            @if (typeCons == "LIVRAISON")
            {
                <div class="t-row"><span>Livraison</span><span>@($"{fraisLivraison:0} FCFA")</span></div>
            }

            <div class="t-row t-row--strong"><span>Total</span><span class="t-accent">@($"{cmd.MontantTotal:0} FCFA")</span></div>

            @if (cmd.EstPayee)
            {
                <div class="paid">✓ Paiement effectué</div>
            }
        </div>
    </div>
</section>
