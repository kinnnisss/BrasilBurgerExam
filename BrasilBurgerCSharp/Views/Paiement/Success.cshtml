@model BrasilBurgerCSharp.DTOs.CommandeDetailsDto

@{
    ViewData["Title"] = "Paiement réussi";
    ViewBag.MinimalHeader = true;

    ViewData["PageBarTitle"] = "Paiement";
    ViewData["PageBarBackUrl"] = Url.Action("Index", "Catalogue");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pagebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paiement.css" asp-append-version="true" />
}

@await Html.PartialAsync("_PageBar")

<section class="pay-success">
    <div class="pay-success__card">
        <div class="pay-success__ok" aria-hidden="true">✓</div>

        <div class="pay-success__title">Paiement réussi !</div>

        <div class="pay-success__sub">
            Votre commande <strong>@Model.Commande.Reference</strong> a été confirmée et sera traitée dans les plus brefs délais.
        </div>

        <div class="pay-success__amount">
            <div class="pay-success__amountLabel">Montant payé</div>
            <div class="pay-success__amountValue">@($"{Model.Commande.MontantTotal:0} FCFA")</div>
        </div>

        <a class="pay-success__btn" asp-controller="Suivi" asp-action="Index">
            Suivre ma commande
        </a>
    </div>
</section>
