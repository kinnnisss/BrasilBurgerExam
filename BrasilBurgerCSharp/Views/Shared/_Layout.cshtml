@using BrasilBurgerCSharp.Core
@{
    var clientId = ClientSession.GetClientId(Context);
    var isAuth = clientId != null;

    var clientName = ViewBag.ClientName as string;
    var minimalHeader = ViewBag.MinimalHeader == true;

    string? returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Brasil Burger</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="bb-body">

@if (!minimalHeader)
{
    <header class="bb-header">
        <div class="bb-header__left">
            <button class="bb-icon-btn bb-hamburger"
                    type="button"
                    aria-label="Menu"
                    aria-controls="bbDrawer"
                    aria-expanded="false"
                    onclick="bbToggleDrawer(true)">
                ☰
            </button>

 
        </div>

        <div class="bb-header__center">
            @if (isAuth)
            {
                <div class="bb-welcome">
                    <div class="bb-welcome__title">Bienvenue</div>
                    <div class="bb-welcome__sub">@(!string.IsNullOrWhiteSpace(clientName) ? clientName : "Client")</div>
                </div>
            }
            else
            {
                <div class="bb-brand">
                    <div class="bb-brand__title">Brasil Burger</div>
                </div>
            }
        </div>

        <div class="bb-header__right">
            <nav class="bb-header-links" aria-label="Navigation">
                @if (!isAuth)
                {
                    <a class="bb-header-link" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl">Se connecter</a>
                    <a class="bb-header-link" asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@returnUrl">S’inscrire</a>
                    <a class="bb-header-link" asp-controller="Home" asp-action="Contact">À propos</a>
                }
                else
                {
                    <a class="bb-header-link" asp-controller="Catalogue" asp-action="Index">Catalogue</a>
                    <a class="bb-header-link" asp-controller="Commande" asp-action="Panier">Commande</a>
                    <a class="bb-header-link" asp-controller="Profil" asp-action="Index">Moi</a>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="bb-header-logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bb-header-logout__btn">Déconnexion</button>
                    </form>
                }
            </nav>

            <a class="bb-icon-link" asp-controller="Commande" asp-action="Panier" title="Panier" aria-label="Panier">
                <span class="bb-cart">
                    🛒
                    <span class="bb-badge" id="bbCartCount">0</span>
                </span>
            </a>
        </div>
    </header>
}

<!-- Drawer mobile -->
<div id="bbDrawerOverlay" class="bb-drawer-overlay" hidden onclick="bbToggleDrawer(false)"></div>

<aside id="bbDrawer" class="bb-drawer" aria-label="Menu" hidden>
    <div class="bb-drawer__header">
        <div class="bb-drawer__title">Menu</div>
        <button class="bb-icon-btn bb-drawer__close" type="button" aria-label="Fermer" onclick="bbToggleDrawer(false)">✕</button>
    </div>

    <nav class="bb-drawer__nav">
 @if (!isAuth)
{
    <a class="bb-drawer__link" asp-controller="Auth" asp-action="Login">Se connecter</a>
    <a class="bb-drawer__link" asp-controller="Auth" asp-action="Register">S’inscrire</a>
    <a class="bb-drawer__link" asp-controller="Home" asp-action="Contact">À propos / Contact</a>
}
else
{
    <a class="bb-drawer__link" asp-controller="Profil" asp-action="Index">Mon profil</a>
    <a class="bb-drawer__link" asp-controller="Home" asp-action="Contact">Aide / Contact</a>

    <form asp-controller="Auth" asp-action="Logout" method="post" class="bb-drawer__form">
        @Html.AntiForgeryToken()
        <button type="submit" class="bb-drawer__logout">Déconnexion</button>
    </form>
}

    </nav>
</aside>

<main class="bb-main @(isAuth ? "bb-main--withnav" : "")">
    @RenderBody()
</main>

@if (isAuth && !minimalHeader)
{
    @await Html.PartialAsync("_BottomNav")
}

<script>
    (function () {
        const drawer = document.getElementById("bbDrawer");
        const overlay = document.getElementById("bbDrawerOverlay");
        const btn = document.querySelector(".bb-hamburger");

        window.bbToggleDrawer = function (open) {
            if (!drawer || !overlay) return;

            if (open) {
                drawer.hidden = false;
                overlay.hidden = false;
                drawer.classList.add("is-open");
                overlay.classList.add("is-open");
                if (btn) btn.setAttribute("aria-expanded", "true");
                document.body.style.overflow = "hidden";

                const closeBtn = drawer.querySelector(".bb-drawer__close");
                if (closeBtn) closeBtn.focus();
            } else {
                drawer.classList.remove("is-open");
                overlay.classList.remove("is-open");
                if (btn) btn.setAttribute("aria-expanded", "false");
                document.body.style.overflow = "";

                window.setTimeout(() => {
                    drawer.hidden = true;
                    overlay.hidden = true;
                    if (btn) btn.focus();
                }, 160);
            }
        };

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && drawer && !drawer.hidden) {
                window.bbToggleDrawer(false);
            }
        });
    })();
</script>

@RenderSection("Scripts", required: false)
</body>
</html>
