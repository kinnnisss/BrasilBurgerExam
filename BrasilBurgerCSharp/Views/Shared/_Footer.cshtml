<footer class="bb-footer" role="contentinfo">
  <div class="bb-footer__inner">

    <div class="bb-footer__brand">
      <div class="bb-footer__logo" aria-hidden="true">🍔</div>
      <div>
        <div class="bb-footer__title">Brasil Burger</div>
        <div class="bb-footer__tagline">Les meilleurs burgers de la ville</div>
      </div>
    </div>

    <div class="bb-footer__cols">

      <div class="bb-footer__col">
        <div class="bb-footer__h">Restaurant</div>
        <div class="bb-footer__p">
          Avenue Cheikh Anta Diop<br />
          Dakar, Sénégal
        </div>

        <a class="bb-footer__link"
           href="https://www.google.com/maps?q=Brasil+Burger+Dakar"
           target="_blank" rel="noopener">
          📍 Voir sur Google Maps
        </a>
      </div>

      <div class="bb-footer__col">
        <div class="bb-footer__h">Contact</div>
        <div class="bb-footer__p">
          Téléphone : <a class="bb-footer__link" href="tel:+221770000000">+221 77 000 00 00</a><br />
          Email : <a class="bb-footer__link" href="mailto:contact@brasilburger.sn">contact@brasilburger.sn</a>
        </div>
        <div class="bb-footer__mini">Réponse rapide 7j/7</div>
      </div>

      <div class="bb-footer__col">
        <div class="bb-footer__h">Horaires</div>
        <div class="bb-footer__p">
          Lun – Jeu : 11h – 23h<br />
          Ven – Dim : 11h – 01h
        </div>
        <div class="bb-footer__mini">Sur place • À emporter • Livraison</div>
      </div>

    </div>

    <div class="bb-footer__bottom">
      <div>© @DateTime.Now.Year Brasil Burger. Tous droits réservés.</div>
      <div class="bb-footer__bottomLinks">
        <a class="bb-footer__bottomLink" asp-controller="Home" asp-action="Contact">À propos</a>
        <span class="bb-footer__dot">•</span>
        <a class="bb-footer__bottomLink" asp-controller="Home" asp-action="Contact">Contact</a>
        <span class="bb-footer__dot">•</span>
        <a class="bb-footer__bottomLink" href="#" onclick="window.scrollTo({top:0, behavior:'smooth'}); return false;">Haut de page</a>
      </div>
    </div>

  </div>
</footer>
