@model bool

@{
    var isAuth = Model;
}

<nav class="bb-top-nav" aria-label="Navigation principale">
    <div class="bb-top-nav__inner">
        @if (!isAuth)
        {
            <a class="bb-top-link" asp-controller="Auth" asp-action="Login">Se connecter</a>
            <a class="bb-top-link" asp-controller="Auth" asp-action="Register">S’inscrire</a>
            <a class="bb-top-link" asp-controller="Home" asp-action="Contact">À propos</a>
        }
        else
        {
            <a class="bb-top-link" asp-controller="Catalogue" asp-action="Index">Catalogue</a>
            <a class="bb-top-link" asp-controller="Suivi" asp-action="Index">Commande</a>
            <a class="bb-top-link" asp-controller="Profil" asp-action="Index">Moi</a>

            <form asp-controller="Auth" asp-action="Logout" method="post" class="bb-top-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="bb-top-logout__btn">Déconnexion</button>
            </form>
        }
    </div>
</nav>
