@model BrasilBurgerCSharp.ViewModels.Auth.RegisterVm
@{
    ViewData["Title"] = "Inscription";
    ViewBag.MinimalHeader = true;

    var returnUrl = (ViewBag.ReturnUrl as string) ?? "";
}

@section Styles {
  <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="bb-auth">
  <div class="bb-auth__card">
    <div class="bb-auth__inner">

      <div class="bb-auth__brand">
        <div class="bb-auth__logo">🍔</div>
        <h1 class="bb-auth__title">Brasil Burger</h1>
        <p class="bb-auth__subtitle">Les meilleurs burgers de la ville</p>
      </div>

      <div class="bb-auth__tabs" role="tablist" aria-label="Authentification">
        <a class="bb-auth__tab"
           asp-controller="Auth" asp-action="Login"
           asp-route-returnUrl="@returnUrl">
          Connexion
        </a>
        <a class="bb-auth__tab is-active"
           asp-controller="Auth" asp-action="Register"
           asp-route-returnUrl="@returnUrl">
          Inscription
        </a>
      </div>

      @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
      {
          <div class="bb-alert">@Model.ErrorMessage</div>
      }

      <form class="bb-auth__form" asp-action="Register" asp-controller="Auth" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="bb-field">
          <label class="bb-label" asp-for="Nom">Nom <span class="req">*</span></label>
          <input class="bb-input" asp-for="Nom" placeholder="Votre nom" autocomplete="family-name" />
          <span class="bb-val" asp-validation-for="Nom"></span>
        </div>

        <div class="bb-field">
          <label class="bb-label" asp-for="Prenom">Prénom <span class="req">*</span></label>
          <input class="bb-input" asp-for="Prenom" placeholder="Votre prénom" autocomplete="given-name" />
          <span class="bb-val" asp-validation-for="Prenom"></span>
        </div>

        <div class="bb-field">
          <label class="bb-label" asp-for="Telephone">Téléphone <span class="req">*</span></label>
          <input class="bb-input" asp-for="Telephone" placeholder="+225 XX XX XX XX XX" inputmode="numeric" autocomplete="tel" />
          <span class="bb-val" asp-validation-for="Telephone"></span>
        </div>

        <div class="bb-field">
          <label class="bb-label" asp-for="Login">Login <span class="req">*</span></label>
          <input class="bb-input" asp-for="Login" placeholder="Votre identifiant" autocomplete="username" />
          <span class="bb-val" asp-validation-for="Login"></span>
        </div>

        <div class="bb-field">
          <label class="bb-label" asp-for="Password">Mot de passe <span class="req">*</span></label>
          <input class="bb-input" asp-for="Password" placeholder="••••••••" autocomplete="new-password" />
          <span class="bb-val" asp-validation-for="Password"></span>
        </div>

        <div class="bb-field">
          <label class="bb-label" asp-for="ConfirmPassword">Confirmation <span class="req">*</span></label>
          <input class="bb-input" asp-for="ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
          <span class="bb-val" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="bb-btn" type="submit">Créer mon compte</button>
      </form>
    </div>

    <div class="bb-auth__divider"></div>

    <div class="bb-auth__footer">
      <strong>Vous êtes gestionnaire ?</strong>
      <a asp-controller="Auth" asp-action="Gestionnaire">Accéder à l'interface de gestion</a>
    </div>
  </div>
</section>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
