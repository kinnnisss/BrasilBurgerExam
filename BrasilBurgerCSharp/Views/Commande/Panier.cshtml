@model BrasilBurgerCSharp.ViewModels.Commande.CheckoutVm
@using BrasilBurgerCSharp.Core

@{
    ViewData["Title"] = "Mon panier";

    var isAuth = ClientSession.GetClientId(Context) != null;
    var isReadonly = Model.ReadonlyMode;

    var type = (Model.TypeConsommation ?? "SUR_PLACE").Trim().ToUpperInvariant();
    bool isDelivery = type == "LIVRAISON";

    var sousTotal = Model.Panier?.Total ?? 0m;

    var selectedZone = (isDelivery && Model.ZoneId is not null)
        ? Model.Zones.FirstOrDefault(z => z.Id == Model.ZoneId.Value)
        : null;

    var fraisLivraison = (isDelivery && selectedZone is not null) ? selectedZone.PrixLivraison : 0m;
    var totalFinal = sousTotal + fraisLivraison;

    var items = Model.Panier?.Items ?? new List<BrasilBurgerCSharp.ViewModels.Commande.PanierItemVm>();
    var mainItems = items.Where(i => !string.Equals(i.TypeArticle, "COMPLEMENT", StringComparison.OrdinalIgnoreCase)).ToList();
    var complements = items.Where(i => string.Equals(i.TypeArticle, "COMPLEMENT", StringComparison.OrdinalIgnoreCase)).ToList();

    string CheckedType(string t) => type == t ? "is-selected" : "";
}


@{
    var backUrl = Context.Request.Headers["Referer"].ToString();
    if (string.IsNullOrWhiteSpace(backUrl))
    {
        backUrl = Url.Action("Index", "Catalogue") ?? "/";
    }
}

@{
    ViewData["PageBarTitle"] = "Mon panier";
    ViewData["PageBarBackUrl"] = Url.Action("Index","Catalogue");
}
@section Styles{
  <link rel="stylesheet" href="~/css/pagebar.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/commande.css" asp-append-version="true" />
}
@await Html.PartialAsync("_PageBar")



<section class="bb-cart-page">

    @if (items.Count == 0)
    {
        <div class="bb-cart-empty">
            <div class="bb-cart-empty__icon">🛒</div>
            <div class="bb-cart-empty__title">Votre panier est vide</div>
            <div class="bb-cart-empty__sub">Ajoutez des produits pour commencer</div>

            <a class="bb-btn bb-btn--primary" asp-controller="Catalogue" asp-action="Index">
                Voir le catalogue
            </a>
        </div>
    }
    else
    {
        <div class="bb-cart-layout">

            <div class="bb-cart-col">

                @* message d'erreur venant du controller *@
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="bb-alert">@Model.ErrorMessage</div>
                }

                <div class="bb-cardbox">
                    <div class="bb-cardbox__title">Articles (@mainItems.Count)</div>

                    <div class="bb-cart-items">
                        @foreach (var it in mainItems)
                        {
                            <div class="bb-cart-item">
                                <div class="bb-cart-item__img">
                                    @if (!string.IsNullOrWhiteSpace(it.Image))
                                    {
                                        <img src="@it.Image" alt="@it.Libelle" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="bb-img-ph"></div>
                                    }
                                </div>

                                <div class="bb-cart-item__content">
                                    <div class="bb-cart-item__name">@it.Libelle</div>
                                    <div class="bb-cart-item__meta">Quantité : @it.Quantite</div>

                                 
                                    @if (complements.Count > 0)
                                    {
                                        <div class="bb-cart-item__extras">
                                            + @string.Join(", ", complements.Select(c => c.Libelle))
                                        </div>
                                    }

                                    <div class="bb-cart-item__price">@($"{it.PrixTotal:0} FCFA")</div>

                                    @if (!isReadonly)
                                    {
                                        <div class="bb-qty">
                                            <form asp-controller="Commande" asp-action="UpdateQuantity" method="post" class="bb-qty__form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="typeArticle" value="@it.TypeArticle" />
                                                <input type="hidden" name="articleId" value="@it.ArticleId" />
                                                <input type="hidden" name="quantite" value="@(it.Quantite - 1)" />
                                                <button class="bb-qty__btn" type="submit" aria-label="Diminuer">−</button>
                                            </form>

                                            <div class="bb-qty__value">@it.Quantite</div>

                                            <form asp-controller="Commande" asp-action="UpdateQuantity" method="post" class="bb-qty__form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="typeArticle" value="@it.TypeArticle" />
                                                <input type="hidden" name="articleId" value="@it.ArticleId" />
                                                <input type="hidden" name="quantite" value="@(it.Quantite + 1)" />
                                                <button class="bb-qty__btn bb-qty__btn--plus" type="submit" aria-label="Augmenter">+</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bb-cart-item__meta">Quantité : <strong>@it.Quantite</strong></div>
                                    }

                                </div>
                                @if (!isReadonly)
                                {
                                <form asp-controller="Commande" asp-action="Remove" method="post" class="bb-cart-item__remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="typeArticle" value="@it.TypeArticle" />
                                    <input type="hidden" name="articleId" value="@it.ArticleId" />
                                    <button type="submit" class="bb-trash" aria-label="Supprimer">🗑</button>
                                </form>
                                }
                            </div>
                        }
                    </div>

                    @* option “vider panier” *@
                    <div class="bb-cart-actions">
                        @if (!isReadonly)
                        {
                        <form asp-controller="Commande" asp-action="Clear" method="post">
                            @Html.AntiForgeryToken()
                            <button class="bb-link-danger" type="submit">Vider le panier</button>
                        </form>
                        }
                    </div>
                </div>
                @if (!isReadonly)
{
                <div class="bb-cardbox">
                    <div class="bb-cardbox__title">Type de consommation</div>

                    <div class="bb-consumption">
                        <a class="bb-choice @CheckedType("SUR_PLACE")"
                           asp-controller="Commande" asp-action="Panier"
                           asp-route-type="SUR_PLACE">
                            <span class="bb-choice__ico">🪑</span>
                            <span class="bb-choice__txt">Sur place</span>
                        </a>

                        <a class="bb-choice @CheckedType("A_EMPORTER")"
                           asp-controller="Commande" asp-action="Panier"
                           asp-route-type="A_EMPORTER">
                            <span class="bb-choice__ico">🛍</span>
                            <span class="bb-choice__txt">À emporter</span>
                        </a>

                        <a class="bb-choice @CheckedType("LIVRAISON")"
                           asp-controller="Commande" asp-action="Panier"
                           asp-route-type="LIVRAISON">
                            <span class="bb-choice__ico">🏍</span>
                            <span class="bb-choice__txt">Livraison</span>
                        </a>
                    </div>
                </div>
            }else
            {
            <div class="bb-cardbox">
                <div class="bb-cardbox__title">Type de consommation</div>
                <div class="bb-alert">Type choisi : <strong>@type</strong></div>
            </div>
            }
            @if (isDelivery)
            {
                <div class="bb-cardbox">
                    <div class="bb-cardbox__title bb-cardbox__title--withicon">
                        <span class="bb-pin">📍</span>
                        <span>Informations de livraison</span>
                    </div>

                    @if (!isReadonly)
                    {
                        <form class="bb-delivery" method="get" asp-controller="Commande" asp-action="Panier">
                            <input type="hidden" name="type" value="LIVRAISON" />

                            <label class="bb-field">
                                <span class="bb-field__label">Zone</span>
                                <select class="bb-field__input" name="zoneId" id="bbZone">
                                    <option value="">-- Choisir une zone --</option>
                                    @foreach (var z in Model.Zones)
                                    {
                                        <option value="@z.Id" selected="@(Model.ZoneId == z.Id)">
                                            @z.Libelle
                                        </option>
                                    }
                                </select>
                            </label>

                            <label class="bb-field">
                                <span class="bb-field__label">Quartier</span>
                                <select class="bb-field__input" name="quartierId" id="bbQuartier">
                                    <option value="">-- Choisir un quartier --</option>
                                    @foreach (var q in Model.Quartiers)
                                    {
                                        <option value="@q.Id" selected="@(Model.QuartierId == q.Id)">
                                            @q.Libelle
                                        </option>
                                    }
                                </select>
                            </label>

                            <div class="bb-fee">
                                Frais de livraison: <strong>@($"{fraisLivraison:0} FCFA")</strong>
                            </div>

                            <button type="submit" class="bb-btn bb-btn--ghost">Mettre à jour</button>
                        </form>
                    }
                    else
                    {
                        <div class="bb-alert">
                            Zone : <strong>@(selectedZone?.Libelle ?? "—")</strong><br />
                            Quartier : <strong>@(Model.Quartiers.FirstOrDefault(q => q.Id == Model.QuartierId)?.Libelle ?? "—")</strong>
                        </div>

                        <div class="bb-fee">
                            Frais de livraison: <strong>@($"{fraisLivraison:0} FCFA")</strong>
                        </div>
                    }
                </div>
            }

                <!-- CARD: Totaux -->
                <div class="bb-cardbox bb-totals">
                    <div class="bb-totalrow">
                        <span>Sous-total</span>
                        <span>@($"{sousTotal:0} FCFA")</span>
                    </div>

                    @if (isDelivery)
                    {
                        <div class="bb-totalrow">
                            <span>Livraison</span>
                            <span>@($"{fraisLivraison:0} FCFA")</span>
                        </div>
                    }

                    <div class="bb-totalrow bb-totalrow--strong">
                        <span>Total</span>
                        <span>@($"{totalFinal:0} FCFA")</span>
                    </div>
                </div>

            </div>

            <div class="bb-cart-col bb-cart-col--cta">
                <form asp-controller="Commande" asp-action="Confirmer" method="post" class="bb-cta">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="TypeConsommation" value="@type" />
                    <input type="hidden" name="ZoneId" value="@(Model.ZoneId?.ToString() ?? "")" />
                    <input type="hidden" name="QuartierId" value="@(Model.QuartierId?.ToString() ?? "")" />

                    <button class="bb-btn bb-btn--primary bb-btn--xl" type="submit">
                        Confirmer la commande (@($"{totalFinal:0} FCFA"))
                    </button>
                </form>
            </div>

        </div>
    }

</section>
<script>
(function () {
  const isReadonly = @Model.ReadonlyMode.ToString().ToLowerInvariant();
  if (isReadonly) return;

  const zone = document.getElementById("bbZone");
  if (!zone) return;

  zone.addEventListener("change", function () {
    const form = zone.closest("form");
    if (!form) return;

    const q = document.getElementById("bbQuartier");
    if (q) q.value = "";

    form.submit();
  });
})();
</script>
