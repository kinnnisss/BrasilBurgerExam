@model BrasilBurgerCSharp.ViewModels.Catalogue.ComplementVm

@{
    ViewData["Title"] = "Détails complément";
}

@section Styles{
    <link rel="stylesheet" href="~/css/pagebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/complement-details.css" asp-append-version="true" />
}

@await Html.PartialAsync("_PageBar")

<section class="bb-comp">

    <div class="bb-comp__hero">
        <div class="bb-comp__imgWrap">
            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <img class="bb-comp__img" src="@Model.Image" alt="@Model.Nom" loading="lazy" />
            }
            else
            {
                <div class="bb-comp__imgPh"></div>
            }
        </div>

        <div class="bb-comp__head">
            <div class="bb-comp__type">@Model.TypeComplement</div>
            <h1 class="bb-comp__title">@Model.Nom</h1>
            <div class="bb-comp__price">@($"{Model.Prix:0} FCFA")</div>
        </div>
    </div>

    <div class="bb-comp__card">
        <div class="bb-comp__cardTitle">À savoir</div>

        <div class="bb-comp__hint">
            Ce complément <strong>ne se commande pas seul</strong>.
            Il est sélectionné lors de la commande d’un <strong>burger</strong> ou d’un <strong>menu</strong>.
        </div>

        <div class="bb-comp__note">
            Astuce : ouvre le détail d’un burger/menu pour l’ajouter à ta commande.
        </div>
    </div>

    <div class="bb-comp__actions">
        <a class="bb-comp__btn bb-comp__btn--ghost"
           href="@(ViewData["PageBarBackUrl"] as string ?? Url.Action("Index","Catalogue") ?? "/")">
            Retour
        </a>

        <a class="bb-comp__btn bb-comp__btn--primary"
           asp-controller="Catalogue" asp-action="Index" asp-route-filtre="BURGER">
            Voir les burgers
        </a>
    </div>

</section>
