{# templates/partials/pagination.html.twig #}
{% if paged.totalPages > 1 %}
  <nav class="bb-pagination" aria-label="Pagination">

    {# Précédent #}
    {% if paged.hasPrev %}
      <a class="bb-page" href="{{ app.request.uri|replace({'page=' ~ paged.page: 'page=' ~ (paged.page - 1)}) }}">Précédent</a>
    {% else %}
      <span class="bb-page is-disabled">Précédent</span>
    {% endif %}

    {# Pages (window) #}
    {% set current = paged.page %}
    {% set total = paged.totalPages %}
    {% set start = current - 2 %}
    {% set end = current + 2 %}
    {% if start < 1 %}{% set start = 1 %}{% endif %}
    {% if end > total %}{% set end = total %}{% endif %}

    {# 1 + ... #}
    {% if start > 1 %}
      <a class="bb-page" href="{{ app.request.uri|replace({'page=' ~ current: 'page=1'}) }}">1</a>
      {% if start > 2 %}
        <span class="bb-page is-disabled">…</span>
      {% endif %}
    {% endif %}

    {# window #}
    {% for p in start..end %}
      {% if p == current %}
        <span class="bb-page is-active">{{ p }}</span>
      {% else %}
        <a class="bb-page" href="{{ app.request.uri|replace({'page=' ~ current: 'page=' ~ p}) }}">{{ p }}</a>
      {% endif %}
    {% endfor %}

    {# ... + last #}
    {% if end < total %}
      {% if end < total - 1 %}
        <span class="bb-page is-disabled">…</span>
      {% endif %}
      <a class="bb-page" href="{{ app.request.uri|replace({'page=' ~ current: 'page=' ~ total}) }}">{{ total }}</a>
    {% endif %}

    {# Suivant #}
    {% if paged.hasNext %}
      <a class="bb-page" href="{{ app.request.uri|replace({'page=' ~ paged.page: 'page=' ~ (paged.page + 1)}) }}">Suivant</a>
    {% else %}
      <span class="bb-page is-disabled">Suivant</span>
    {% endif %}

  </nav>
{% endif %}
