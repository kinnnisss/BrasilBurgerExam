    <title>{% block title %}Brasil Burger – Gestion{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# CSS global #}
    <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>

<div class="layout">
