{# templates/base.html.twig #}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}Brasil Burger{% endblock %}</title>

  <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
</head>
<body>

  <div class="bb-shell">
    <aside class="bb-sidebar">
      {% include 'partials/sidebar.html.twig' %}
    </aside>

    <main class="bb-main">
      <header class="bb-pagehead">
        <h1 class="bb-pagehead__title">{% block page_title %}{% endblock %}</h1>
        <div class="bb-pagehead__sub">{% block page_subtitle %}{% endblock %}</div>
      </header>

      <div class="bb-content">
        {% block body %}{% endblock %}
      </div>
    </main>
  </div>

  {% block javascripts %}{% endblock %}
</body>
</html>
