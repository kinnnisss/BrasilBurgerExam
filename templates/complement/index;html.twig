{# templates/complement/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Compléments{% endblock %}
{% block page_title %}Gestion des Compléments{% endblock %}
{% block page_subtitle %}Gérez vos frites et boissons{% endblock %}

{% block body %}


  <section class="page-toolbar">
    <div class="page-toolbar__left">
      {{ form_start(form, { attr: { class: 'filterbar' } }) }}
        <div class="filterbar__row">

          {% if form.q is defined %}
            <div class="filterbar__field">
              {{ form_widget(form.q, { attr: { class: 'bb-input', placeholder: 'Rechercher un complément...' } }) }}
            </div>
          {% endif %}

          {% if form.type is defined %}
            <div class="filterbar__field">
              {{ form_widget(form.type, { attr: { class: 'bb-select' } }) }}
            </div>
          {% endif %}

          {% if form.status is defined %}
            <div class="filterbar__field">
              {{ form_widget(form.status, { attr: { class: 'bb-select' } }) }}
            </div>
          {% endif %}

          <button class="bb-btn bb-btn--ghost" type="submit">Filtrer</button>
        </div>
      {{ form_end(form) }}
    </div>

    <div class="page-toolbar__right">
      <a class="bb-btn bb-btn--primary" href="{{ path('complement_create') }}">
        <span class="bb-btn__icon">＋</span>
        Ajouter un complément
      </a>
    </div>
  </section>


  <section class="card-table">
    <div class="card-table__inner">

      <table class="bb-table">
        <thead>
        <tr>
          <th class="col-image">Image</th>
          <th>Nom</th>
          <th>Type</th>
          <th class="col-price">Prix</th>
          <th class="col-status">Statut</th>
          <th class="col-actions">Actions</th>
        </tr>
        </thead>

        <tbody>
        {% for c in paged.items %}
          <tr>

            <td class="col-image">
              <div class="thumb">
                {% if c.image %}
                  <img src="{{ c.image }}" alt="{{ c.nom }}">
                {% else %}
                  <div class="thumb__placeholder">➕</div>
                {% endif %}
              </div>
            </td>

            <td class="bb-strong">
              {{ c.nom }}
            </td>

            <td>
              {# typeComplement peut être Enum -> value, ou string selon ton DTO #}
              {% set t = c.typeComplement.value is defined ? c.typeComplement.value : c.typeComplement %}

              {% if t == 'FRITE' %}
                <span class="pill pill--yellow">Frites</span>
              {% elseif t == 'BOISSON' %}
                <span class="pill pill--blue">Boisson</span>
              {% else %}
                <span class="pill pill--gray">{{ t }}</span>
              {% endif %}
            </td>

            <td class="col-price price">
              {{ c.prix }}<br><span class="price__unit">FCFA</span>
            </td>

            <td class="col-status">
              {% if c.isArchived %}
                <span class="pill pill--gray">Archivé</span>
              {% else %}
                <span class="pill pill--green">Actif</span>
              {% endif %}
            </td>

            <td class="col-actions">
              <div class="actions">

                <a class="icon-btn"
                   href="{{ path('complement_edit', { id: c.id }) }}"
                   title="Modifier">✏️</a>

                {% if c.isArchived %}
                  <form method="post" action="{{ path('complement_unarchive', { id: c.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('complement_unarchive_' ~ c.id) }}">
                    <button class="icon-btn" type="submit" title="Désarchiver">📤</button>
                  </form>
                {% else %}
                  <form method="post" action="{{ path('complement_archive', { id: c.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('complement_archive_' ~ c.id) }}">
                    <button class="icon-btn" type="submit" title="Archiver">🗑️</button>
                  </form>
                {% endif %}

              </div>
            </td>

          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="empty-row">Aucun complément trouvé.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

    </div>
  </section>

  {% set totalPages = (paged.totalPages is defined) ? paged.totalPages : ((paged.totalItems / paged.pageSize)|round(0, 'ceil')) %}
  {% set current = paged.page %}

  {% if totalPages > 1 %}
    <nav class="bb-pagination" aria-label="Pagination">

      {% set baseQuery = app.request.query.all %}
      {% set baseQuery = baseQuery|merge({'page': null}) %}

      {% if current > 1 %}
        <a class="bb-page" href="{{ path(app.request.attributes.get('_route'), baseQuery|merge({'page': current - 1})) }}">Précédent</a>
      {% else %}
        <span class="bb-page is-disabled">Précédent</span>
      {% endif %}

      {% set start = current - 2 %}
      {% set end = current + 2 %}
      {% if start < 1 %}{% set start = 1 %}{% endif %}
      {% if end > totalPages %}{% set end = totalPages %}{% endif %}

      {% if start > 1 %}
        <a class="bb-page" href="{{ path(app.request.attributes.get('_route'), baseQuery|merge({'page': 1})) }}">1</a>
        {% if start > 2 %}
          <span class="bb-page is-disabled">…</span>
        {% endif %}
      {% endif %}

      {% for p in start..end %}
        {% if p == current %}
          <span class="bb-page is-active">{{ p }}</span>
        {% else %}
          <a class="bb-page" href="{{ path(app.request.attributes.get('_route'), baseQuery|merge({'page': p})) }}">{{ p }}</a>
        {% endif %}
      {% endfor %}

      {% if end < totalPages %}
        {% if end < totalPages - 1 %}
          <span class="bb-page is-disabled">…</span>
        {% endif %}
        <a class="bb-page" href="{{ path(app.request.attributes.get('_route'), baseQuery|merge({'page': totalPages})) }}">{{ totalPages }}</a>
      {% endif %}

      {% if current < totalPages %}
        <a class="bb-page" href="{{ path(app.request.attributes.get('_route'), baseQuery|merge({'page': current + 1})) }}">Suivant</a>
      {% else %}
        <span class="bb-page is-disabled">Suivant</span>
      {% endif %}

    </nav>
  {% endif %}

{% endblock %}
