{# templates/menu/_modal_upsert.html.twig #}

{% set closeUrl = path('menu_index', app.request.query.all|merge({'action': null, 'edit': null})) %}

{% if showCreateModal and createForm %}
  <div class="bb-modal is-open" role="dialog" aria-modal="true" aria-labelledby="modal-title-create-menu">
    <a class="bb-modal__backdrop" href="{{ closeUrl }}" aria-label="Fermer la fenêtre"></a>

    <div class="bb-modal__panel">
      <div class="bb-modal__head">
        <h3 id="modal-title-create-menu" class="bb-modal__title">Ajouter un menu</h3>
        <a class="bb-modal__close" href="{{ closeUrl }}" aria-label="Fermer">✕</a>
      </div>

      <div class="bb-modal__body">
        {{ form_start(createForm, { attr: { class: 'bb-form' } }) }}
          <input type="hidden" name="mode" value="create">

          <div class="bb-field">
            <label class="bb-label">Nom <span class="req">*</span></label>
            {{ form_widget(createForm.nom, { attr: { class: 'bb-input', placeholder: 'Ex: Menu Brasil' } }) }}
            {{ form_errors(createForm.nom) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Burger <span class="req">*</span></label>
            {{ form_widget(createForm.burgerId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(createForm.burgerId) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Frites <span class="req">*</span></label>
            {{ form_widget(createForm.fritesId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(createForm.fritesId) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Boisson <span class="req">*</span></label>
            {{ form_widget(createForm.boissonId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(createForm.boissonId) }}
          </div>
          {% if createForm.imageFile is defined %}
            <div class="bb-field">
              <label class="bb-label">Image</label>
              {{ form_widget(createForm.imageFile, { attr: { class: 'bb-input' } }) }}
              {{ form_errors(createForm.imageFile) }}
            </div>
          {% endif %}

          <div class="bb-modal__actions">
            <a class="bb-btn bb-btn--ghost" href="{{ closeUrl }}">Annuler</a>
            <button class="bb-btn bb-btn--success" type="submit">Ajouter</button>
          </div>

        {{ form_end(createForm) }}
      </div>
    </div>
  </div>
{% endif %}


{% if showEditModal and editForm and editData %}
  <div class="bb-modal is-open" role="dialog" aria-modal="true" aria-labelledby="modal-title-edit-menu">
    <a class="bb-modal__backdrop" href="{{ closeUrl }}" aria-label="Fermer la fenêtre"></a>

    <div class="bb-modal__panel">
      <div class="bb-modal__head">
        <h3 id="modal-title-edit-menu" class="bb-modal__title">Modifier le menu</h3>
        <a class="bb-modal__close" href="{{ closeUrl }}" aria-label="Fermer">✕</a>
      </div>

      <div class="bb-modal__body">
        {{ form_start(editForm, { attr: { class: 'bb-form' } }) }}
          <input type="hidden" name="mode" value="edit">
          <input type="hidden" name="editId" value="{{ editData.id }}">

          <div class="bb-field">
            <label class="bb-label">Nom <span class="req">*</span></label>
            {{ form_widget(editForm.nom, { attr: { class: 'bb-input' } }) }}
            {{ form_errors(editForm.nom) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Burger <span class="req">*</span></label>
            {{ form_widget(editForm.burgerId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(editForm.burgerId) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Frites <span class="req">*</span></label>
            {{ form_widget(editForm.fritesId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(editForm.fritesId) }}
          </div>

          <div class="bb-field">
            <label class="bb-label">Boisson <span class="req">*</span></label>
            {{ form_widget(editForm.boissonId, { attr: { class: 'bb-select' } }) }}
            {{ form_errors(editForm.boissonId) }}
          </div>
            {# ====== Calcul auto (JS) ====== #}
            <div class="bb-pricebox" data-menu-pricebox>
            <div class="bb-pricebox__row">
                <div class="bb-pricebox__label">Total composants</div>
                <div class="bb-pricebox__value"><span data-total-items>—</span> FCFA</div>
            </div>

            <div class="bb-pricebox__row">
                <div class="bb-pricebox__label">Économie (15%)</div>
                <div class="bb-pricebox__value"><span data-economy-amount>—</span> FCFA</div>
            </div>

            <div class="bb-pricebox__row bb-pricebox__row--strong">
                <div class="bb-pricebox__label">Prix menu estimé</div>
                <div class="bb-pricebox__value">
                <span data-menu-price>—</span> FCFA
                <span class="bb-pricebox__badge" data-badge>—</span>
                </div>
            </div>
            </div>

          {% if editForm.imageFile is defined %}
            <div class="bb-field">
              <label class="bb-label">Image (optionnel)</label>
              {{ form_widget(editForm.imageFile, { attr: { class: 'bb-input' } }) }}
              {{ form_errors(editForm.imageFile) }}

              {% if editData.currentImagePath is defined and editData.currentImagePath %}
                <div class="bb-hint" style="margin-top:8px;">
                  Image actuelle :
                  <a href="{{ editData.currentImagePath }}" target="_blank" rel="noreferrer">voir</a>
                </div>
              {% endif %}
            </div>
          {% endif %}

          <div class="bb-modal__actions">
            <a class="bb-btn bb-btn--ghost" href="{{ closeUrl }}">Annuler</a>
            <button class="bb-btn bb-btn--success" type="submit">Modifier</button>
          </div>

        {{ form_end(editForm) }}
      </div>
    </div>
  </div>
{% endif %}
<script>
(function () {
  if (window.__bbMenuPriceInit) return;
  window.__bbMenuPriceInit = true;

  const ECONOMY_PERCENT = 15;

  function parsePriceFromOptionText(text) {
    const m = String(text).match(/(\d+(?:[.,]\d+)?)\s*$/);
    if (!m) return 0;
    return parseFloat(m[1].replace(',', '.')) || 0;
  }

  function fmt(n) {
    if (!isFinite(n)) return '0';
    return Math.round(n).toString();
  }

  function updateBox(box) {
    const root = box.closest('.bb-modal') || document;
    const burgerSel  = root.querySelector('select[name$="[burgerId]"]');
    const fritesSel  = root.querySelector('select[name$="[fritesId]"]');
    const boissonSel = root.querySelector('select[name$="[boissonId]"]');

    if (!burgerSel || !fritesSel || !boissonSel) return;

    const burgerText  = burgerSel.options[burgerSel.selectedIndex]?.text || '';
    const fritesText  = fritesSel.options[fritesSel.selectedIndex]?.text || '';
    const boissonText = boissonSel.options[boissonSel.selectedIndex]?.text || '';

    const burgerPrice  = parsePriceFromOptionText(burgerText);
    const fritesPrice  = parsePriceFromOptionText(fritesText);
    const boissonPrice = parsePriceFromOptionText(boissonText);

    const total = burgerPrice + fritesPrice + boissonPrice;
    const economyAmount = total * (ECONOMY_PERCENT / 100);
    const menuPrice = total - economyAmount;

    box.querySelector('[data-total-items]').textContent = fmt(total);
    box.querySelector('[data-economy-amount]').textContent = fmt(economyAmount);
    box.querySelector('[data-menu-price]').textContent = fmt(menuPrice);

    const badge = box.querySelector('[data-badge]');
    if (badge) {
      badge.textContent = `-${ECONOMY_PERCENT}%`;
      badge.classList.toggle('is-ok', total > 0);
    }
  }

  function bindModal(modal) {
    const box = modal.querySelector('[data-menu-pricebox]');
    if (!box) return;

    const selects = modal.querySelectorAll('select[name$="[burgerId]"], select[name$="[fritesId]"], select[name$="[boissonId]"]');
    selects.forEach(s => s.addEventListener('change', () => updateBox(box)));

    updateBox(box);
  }

  document.querySelectorAll('.bb-modal.is-open').forEach(bindModal);

})();
</script>
