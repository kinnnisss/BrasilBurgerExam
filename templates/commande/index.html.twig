{# templates/commande/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block body %}
<div class="bb-cmd">

    <header class="bb-cmd__header">
        <h1 class="bb-cmd__title">Gestion des Commandes</h1>
        <p class="bb-cmd__subtitle">Gérez toutes les commandes de vos clients</p>
    </header>

    <section class="bb-card bb-cmd__filters">
        <div class="bb-card__head">
            <div class="bb-card__head-left">
                <span class="bb-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="bb-card__title">Filtres</span>
            </div>
        </div>

        <div class="bb-card__body">
            {{ form_start(form, { attr: { class: 'bb-filter-form' } }) }}

            <div class="bb-filter-grid">
                <div class="bb-field">
                    <div class="bb-label">{{ form_label(form.date) }}</div>
                    {{ form_widget(form.date, { attr: { class: 'bb-input', placeholder: 'JJ/MM/AAAA' } }) }}
                    {{ form_errors(form.date) }}
                </div>

                <div class="bb-field">
                    <div class="bb-label">{{ form_label(form.etat) }}</div>
                    {{ form_widget(form.etat, { attr: { class: 'bb-input' } }) }}
                    {{ form_errors(form.etat) }}
                </div>

                <div class="bb-field">
                    <div class="bb-label">{{ form_label(form.typeArticle) }}</div>
                    {{ form_widget(form.typeArticle, { attr: { class: 'bb-input' } }) }}
                    {{ form_errors(form.typeArticle) }}
                </div>

                <div class="bb-filter-actions">
                    <button class="bb-btn bb-btn--ghost" type="button"
                            onclick="window.location.href='{{ path('commande_index') }}'">
                        Réinitialiser
                    </button>
                </div>
            </div>

            {% if form.page is defined %}{{ form_widget(form.page) }}{% endif %}
            {% if form.pageSize is defined %}{{ form_widget(form.pageSize) }}{% endif %}

            {{ form_end(form) }}
        </div>
    </section>

    <section class="bb-card bb-cmd__list">
        <div class="bb-table-wrap">
            <table class="bb-table">
                <thead>
                <tr>
                    <th>Référence</th>
                    <th>Date</th>
                    <th>Client</th>
                    <th>Type</th>
                    <th>Montant</th>
                    <th>État</th>
                    <th class="bb-table__actions">Actions</th>
                </tr>
                </thead>

                <tbody>
                {% set items = paged.items ?? [] %}
                {% if items is empty %}
                    <tr>
                        <td colspan="7" class="bb-empty">
                            Aucune commande trouvée.
                        </td>
                    </tr>
                {% else %}
                    {% for it in items %}
                        {% set etat = it.etat is not null ? it.etat.value : '' %}

                        <tr>
                            <td class="bb-ref">{{ it.reference }}</td>

                            <td class="bb-date">
                                <div class="bb-date__top">
                                    {{ it.dateCommande ? it.dateCommande|date('d/m/Y') : '-' }}
                                </div>
                                <div class="bb-date__sub">
                                    {{ it.dateCommande ? it.dateCommande|date('H:i') : '' }}
                                </div>
                            </td>

                            <td class="bb-client">
                                <div class="bb-client__name">{{ it.clientNomComplet }}</div>
                                <div class="bb-client__tel">{{ it.clientTelephone }}</div>
                            </td>

                            <td class="bb-type">
                                <span class="bb-type__icon" aria-hidden="true">
                                    {% set tc = it.typeConsommation is not null ? it.typeConsommation.value : '' %}
                                    {% if tc == 'LIVRAISON' %}🏍
                                    {% elseif tc == 'SUR_PLACE' %}🪑
                                    {% elseif tc == 'A_EMPORTER' or tc == 'AEMPORTER' %}🛍
                                    {% else %}🧾{% endif %}
                                </span>
                                <span class="bb-type__text">
                                    {% if tc == 'SUR_PLACE' %}Sur place
                                    {% elseif tc == 'A_EMPORTER' or tc == 'AEMPORTER' %}À emporter
                                    {% elseif tc == 'LIVRAISON' %}Livraison
                                    {% else %}{{ tc }}{% endif %}
                                </span>
                            </td>

                            <td class="bb-money">
                                <div class="bb-money__value">{{ it.montantTotal }}</div>
                                <div class="bb-money__sub">FCFA</div>
                            </td>

                            <td>
                                <span class="bb-badge
                                    {% if etat == 'ENCOURS' %}bb-badge--warn{% endif %}
                                    {% if etat == 'VALIDEE' %}bb-badge--info{% endif %}
                                    {% if etat == 'TERMINER' %}bb-badge--success{% endif %}
                                    {% if etat == 'ANNULEE' %}bb-badge--danger{% endif %}
                                ">
                                    {% if etat == 'ENCOURS' %}En cours
                                    {% elseif etat == 'VALIDEE' %}Validée
                                    {% elseif etat == 'TERMINER' %}Terminée
                                    {% elseif etat == 'ANNULEE' %}Annulée
                                    {% else %}{{ etat }}{% endif %}
                                </span>
                            </td>

                            <td class="bb-actions">
                                <a class="bb-eye"
                                   href="{{ path('commande_details', { id: it.id }) }}"
                                   title="Voir">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                                        <path d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7S2.5 12 2.5 12Z"
                                              stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                                              stroke="currentColor" stroke-width="2"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>

        <div class="bb-cmd__pagination">
            {% include 'partials/pagination.html.twig' with { paged: paged, route: 'commande_index' } %}
        </div>
    </section>

</div>
{% endblock %}
