{# templates/burger/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Burgers{% endblock %}
{% block page_title %}Gestion des Burgers{% endblock %}
{% block page_subtitle %}Gérez votre catalogue de burgers{% endblock %}

{% block body %}

  {# =========================
     Toolbar (filtres + bouton)
     ========================= #}
  <section class="page-toolbar">
    <div class="page-toolbar__left">
      {{ form_start(form, { attr: { class: 'filterbar' } }) }}
        <div class="filterbar__row">

          {% if form.q is defined %}
            <div class="filterbar__field">
              {{ form_widget(form.q, {
                attr: {
                  class: 'bb-input',
                  placeholder: 'Rechercher un burger...'
                }
              }) }}
            </div>
          {% endif %}

          {% if form.status is defined %}
            <div class="filterbar__field">
              {{ form_widget(form.status, { attr: { class: 'bb-select' } }) }}
            </div>
          {% endif %}

          <button class="bb-btn bb-btn--ghost" type="submit">
            Filtrer
          </button>

        </div>
      {{ form_end(form) }}
    </div>

    <div class="page-toolbar__right">
        {% set qs = app.request.query.all %}
        <a class="bb-btn bb-btn--primary"
          href="{{ path('burger_index', qs|merge({ action: 'create' })) }}">
          <span class="bb-btn__icon">＋</span>
        Ajouter un burger
      </a>
    </div>
  </section>

  {# =========================
     Tableau
     ========================= #}
  <section class="card-table">
    <div class="card-table__inner">

      <table class="bb-table">
        <thead>
          <tr>
            <th class="col-image">Image</th>
            <th>Nom</th>
            <th class="col-price">Prix</th>
            <th class="col-status">Statut</th>
            <th class="col-actions">Actions</th>
          </tr>
        </thead>

        <tbody>
        {% for b in paged.items %}
          <tr>

            {# Image #}
            <td class="col-image">
              <div class="thumb">
                {% if b.image %}
                  <img src="{{ b.image }}" alt="{{ b.nom }}">
                {% else %}
                  <div class="thumb__placeholder">🍔</div>
                {% endif %}
              </div>
            </td>

            {# Nom #}
            <td class="bb-strong">
              {{ b.nom }}
            </td>

            {# Prix #}
            <td class="col-price price">
              {{ b.prix }}<br>
              <span class="price__unit">FCFA</span>
            </td>

            {# Statut #}
            <td class="col-status">
              {% if b.isArchived %}
                <span class="pill pill--gray">Archivé</span>
              {% else %}
                <span class="pill pill--green">Actif</span>
              {% endif %}
            </td>

            {# Actions #}
            <td class="col-actions">
              <div class="actions">

                <a class="icon-btn"
                href="{{ path('burger_index', qs|merge({ edit: b.id })) }}"
                title="Modifier">
                  ✏️
                </a>

                {% if b.isArchived %}
                  <form method="post"
                        action="{{ path('burger_unarchive', { id: b.id }) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('burger_unarchive_' ~ b.id) }}">
                    <button class="icon-btn" type="submit" title="Désarchiver">
                      📤
                    </button>
                  </form>
                {% else %}
                  <form method="post"
                        action="{{ path('burger_archive', { id: b.id }) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('burger_archive_' ~ b.id) }}">
                    <button class="icon-btn" type="submit" title="Archiver">
                      🗑️
                    </button>
                  </form>
                {% endif %}

              </div>
            </td>

          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="empty-row">
              Aucun burger trouvé.
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

    </div>
  </section>

{% include 'partials/pagination.html.twig' with { paged: paged, route: 'burger_index' } %}

  {% if showCreateModal and createForm %}
    {% include 'burger/_modal_upsert.html.twig' with {
      modal: {
        type: 'create',
        form: createForm
      }
    } %}
  {% endif %}

  {% if showEditModal and editForm %}
    {% include 'burger/_modal_upsert.html.twig' with {
      modal: {
        type: 'edit',
        form: editForm,
        edit: editData
      }
    } %}
  {% endif %}

{% endblock %}
{% block javascripts %}
  {{ parent() }}
  <script>
    (function () {
      const modal = document.querySelector('.bb-modal.is-open');
      if (!modal) return;

      document.documentElement.classList.add('bb-modal-open');

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          window.location.href = "{{ path('burger_index') }}";
        }
      }, { once: true });

      window.addEventListener('beforeunload', function(){
        document.documentElement.classList.remove('bb-modal-open');
      });
    })();
  </script>
{% endblock %}
